# CodePilot 环境变量示例：复制为 .env 后按需修改（不要提交真实凭据）
# docker compose 会自动读取同目录的 .env 文件。

# ---- 数据库（宪法第三条：PostgreSQL 是唯一事实来源）-----------------------------
CODEPILOT_DATABASE_URL=postgresql+psycopg://codepilot:codepilot@localhost:55432/codepilot
# 本地无 PostgreSQL 时的测试降级（仅用于开发/CI，不代表验收通过）：
# CODEPILOT_DATABASE_URL=sqlite+pysqlite:///./var/codepilot.db

# ---- 运行模式：single / a2a / offline（宪法第二条）------------------------------
CODEPILOT_MODE=a2a
CODEPILOT_CONFIG=examples/.codepilot.yaml
CODEPILOT_DATA_ROOT=./var

# ---- 编排行为 ------------------------------------------------------------------
# 1 = 启动时恢复未完成父任务（已完成子任务不会重放，FR-097）
CODEPILOT_RECOVER_ON_START=1
# 1 = 创建审查任务后自动进入 Fix/Verify（默认 0：由 POST /reviews/{id}/fixes 显式触发）
CODEPILOT_AUTO_FIX=0
# 应用自身日志级别（api 启动会打印 A2A transport=inprocess|http）
CODEPILOT_LOG_LEVEL=INFO

# ---- HTTP A2A（阶段五）---------------------------------------------------------
# a2a 模式下 Coordinator 调用远程 Agent 的地址。留空 = 进程内 InProcessInvoker。
# Compose 拆分形态：把下面两行改为
#   CODEPILOT_A2A_BASE_URL=http://agent:8100
# 然后 `docker compose --profile split up -d`。
# 验收拆分是否真的走 HTTP：curl -s http://127.0.0.1:8099/readyz 中的 transport 字段，
# 或 `docker compose logs api | grep "A2A transport="`（要求为 http）。
# 注意：Compose 不会自动转发未在 docker-compose.yml 中声明的宿主机变量，
# 因此这两个值必须写在本文件（.env）里或先 export 再执行 compose 命令。
CODEPILOT_A2A_BASE_URL=
# 按 Agent 路由（可选）：CODEPILOT_A2A_ROUTES=review-agent=http://agent:8100,impact-agent=http://agent:8100

# ---- Docker 沙箱（阶段六，宪法第八条）------------------------------------------
CODEPILOT_SANDBOX_IMAGE=codepilot-sandbox:local
# 1 = 打开故障注入接口 /internal/a2a/_faults（仅测试与评测环境使用）
CODEPILOT_FAULT_INJECTION=0

# ---- 生成层（默认确定性 provider，不访问网络）-----------------------------------
# offline（默认）| openai（OpenAI 兼容接口，如 DeepSeek）
CODEPILOT_LLM_PROVIDER=offline
CODEPILOT_LLM_MODEL=deepseek-chat
CODEPILOT_LLM_BASE_URL=
CODEPILOT_LLM_API_KEY=

# ---- 测试与评测 ----------------------------------------------------------------
# 可选：指定集成测试使用的 PostgreSQL
CODEPILOT_TEST_POSTGRES_URL=postgresql+psycopg://codepilot:codepilot@localhost:55432/codepilot
# 可选：迁移验证使用的独立数据库名
CODEPILOT_MIGRATION_TEST_DB=codepilot_migration_test
